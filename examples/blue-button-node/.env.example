# Register an app at https://sandbox.bluebutton.cms.gov to get these.
BB_CLIENT_ID=
BB_CLIENT_SECRET=

# Must exactly match the callback URL registered in the Blue Button app settings.
BB_REDIRECT_URI=http://localhost:3000/callback

# Sandbox. Production swaps this to https://api.bluebutton.cms.gov
BB_BASE_URL=https://sandbox.bluebutton.cms.gov

SESSION_SECRET=change-me
PORT=3000
