# Meta Model API key (https://dev.meta.ai). The OpenAI SDK does not read this
# variable on its own; src/llm.py passes it explicitly.
MODEL_API_KEY=

# Set MOCK_LLM=1 to run everything offline with scripted models (no key needed).
MOCK_LLM=0

# Default endpoint for every role. OpenAI-compatible.
META_BASE_URL=https://api.meta.ai/v1

# Per-role model overrides. Defaults shown.
PLANNER_MODEL=muse-wonder-1.0
WORKER_MODEL=muse-spark-1.3
OFFICE_MODEL=muse-spark-1.3
JUDGE_MODEL=muse-spark-1.3
CRITIC_MODEL=muse-wonder-1.0

# Reasoning effort per role: minimal|low|medium|high|xhigh, or "off" to omit.
WORKER_REASONING=low
OFFICE_REASONING=minimal

# Optional: run the simulated receptionists on open-weight Muse Spark via a
# partner host (uses the hackathon partner credits, and avoids Meta rate limits
# during big eval runs). Uncomment and fill in.
# OFFICE_BASE_URL=https://api.fireworks.ai/inference/v1
# OFFICE_MODEL=accounts/fireworks/models/muse-spark-open
# OFFICE_API_KEY_ENV=FIREWORKS_API_KEY
# OFFICE_REASONING=off
# FIREWORKS_API_KEY=

# Virtual-seconds-to-real-seconds scale for simulated hold time (0 = instant).
HOLD_SCALE=0.02

# --- Hosting (see DEPLOY.md) ---
# Required for live runs and approvals on a hosted server. Without it, live
# runs are disabled (unless MOCK_LLM=1). Use a long random string.
APP_ACCESS_TOKEN=
MAX_LIVE_RUNS_PER_DAY=30
MIN_SECONDS_BETWEEN_RUNS=10
# REPLAY_FILE=recordings/demo.jsonl
# RUN_DIR=data/runs
